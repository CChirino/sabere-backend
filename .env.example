APP_NAME=Sabere
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# IMPORTANTE: En producción cambiar a APP_DEBUG=false y APP_ENV=production
APP_URL=http://localhost
APP_PORT=5500

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE
APP_TIMEZONE=America/Caracas

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# IMPORTANTE: En producción cambiar LOG_LEVEL=error

# Registro público (false = solo administradores pueden crear usuarios)
ALLOW_PUBLIC_REGISTRATION=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sabere
DB_USERNAME=sabere_user
DB_PASSWORD=CAMBIAR_CONTRASENA_SEGURA

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
# IMPORTANTE: En producción cambiar a SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# IMPORTANTE: En producción usar SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SANCTUM_TOKEN_EXPIRATION=60
# Expiración del token API en minutos. Recomendado: 60 para producción.
SANCTUM_TOKEN_PREFIX=sabere_

# ============================================================
# CORS — Lista los dominios frontend permitidos (separados por coma)
# ============================================================
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# ============================================================
# Google OAuth — Generar credenciales en console.cloud.google.com
# NUNCA comprometer credenciales reales en el repositorio
# ============================================================
GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID_AQUI
GOOGLE_CLIENT_SECRET=TU_GOOGLE_CLIENT_SECRET_AQUI
GOOGLE_REDIRECT_URI=http://localhost:5500/api/v1/login/google/callback

# ============================================================
# Reverb (WebSockets) — Generar con: php artisan reverb:install
# NUNCA comprometer credenciales reales en el repositorio
# ============================================================
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Desarrollo local
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Producción: usar el dominio real donde corra Reverb (ej. demo.sabereapp.com)
# y asegurar que el CSP permita wss://demo.sabereapp.com:puerto.
# Si se deja localhost, Echo se desactiva automáticamente en el cliente.

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

WWWUSER=1000
WWWGROUP=1000
